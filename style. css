:root{--bg:#f6f3ec;--card:#fffdf8;--ink:#1b2742;--line:#d9d3c4;--lost:#c8432f;--found:#1f7a5a;--
  claimed:#7a7f8c;--gold:#f2c230;color-scheme:light dark;padding-top:env(safe-area-inset-top,0px);padding-
  bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-
  theme=light]){--bg:#121a2c;--card:#1b2540;--ink:#f1eee4;--line:#33405f}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,"Segoe UI",sans-serif}
.wrap{max-width:960px;margin:auto;padding:20px 16px 40px}
h1{font-size:2.6rem;margin:0}
.stats{color:var(--lost);font-weight:700}
form,.card{background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:16px}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
label{display:flex;flex-direction:column;gap:4px;font-weight:600}
input,select,textarea{font:inherit;padding:8px;border:1.5px solid var(--line);border-
  radius:8px;background:var(--bg);color:var(--ink)}
.full{grid-column:1/-1}
button{font:inherit;font-weight:700;padding:8px 16px;border:1.5px solid var(--ink);border-
  radius:8px;background:var(--gold);color:#1b2742;cursor:pointer}
.err{color:var(--lost)}
.tools{display:flex;gap:10px;margin:20px 0 12px}
.tools input{flex:1}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.card{border-top:8px solid var(--lost)}
.card.found{border-top-color:var(--found)}
.card.claimed{border-top-color:var(--claimed);opacity:.7}
.card h3{margin:4px 0}
.card p{margin:4px 0}
